{
  "name": "kiteninja",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/migrate-on-build.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "test:db": "tsx scripts/verify-db.ts",
    "test:sql": "tsx scripts/verify-sql.ts",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npx capacitor sync",
    "cap:open:android": "npx capacitor open android",
    "android:build:debug": "cd android && ./gradlew assembleDebug",
    "android:build:release": "cd android && ./gradlew assembleRelease",
    "android:build:debug:ci": "cd android && ./gradlew assembleDebug -x lint -x lintVitalRelease --no-daemon -Dorg.gradle.java.home=$JAVA_HOME",
    "check:all": "npm run typecheck && npm run lint && npm run test && npm run test:sql",
    "bump": "tsx scripts/bump-version.ts"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "8.5.0",
    "@capacitor/push-notifications": "8.0.1",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "2.0.1",
    "bcryptjs": "^3.0.3",
    "firebase-admin": "14.3.0",
    "jose": "^6.2.8",
    "leaflet": "1.9.4",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "5.0.0",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@electric-sql/pglite": "^0.5.5",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "1.9.20",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "type": "module"
}
