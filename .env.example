# Connection string POOLED do Neon (o host precisa ter "-pooler").
# Sem o pooler, cada invocação serverless na Vercel abre conexão nova e o Neon
# estoura o limite. Painel do Neon -> Connection Details -> Pooled connection.
DATABASE_URL="postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# URL pública do app. Usada para montar os links de convite.
# Em produção: https://kiteninja.vercel.app
# Local: deixe vazio — o app usa a origem da própria requisição.
APP_URL=""

# Nenhuma chave de API de clima é necessária: o Open-Meteo é aberto.
# Se algum dia entrar uma chave, ela fica SÓ aqui (server-side).
# Nunca use o prefixo NEXT_PUBLIC_ para segredo: isso o embute no bundle do
# navegador e qualquer visitante consegue ler.

# Web Push (VAPID) — sem estas duas chaves, `sendPushToUser` devolve 0 e NENHUM
# push de SOS sai do servidor. É silencioso: nada quebra, ninguém é avisado.
# Gere o par uma única vez com:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# A pública pode ser NEXT_PUBLIC_ (o navegador precisa dela para se inscrever).
# A privada, jamais — ela assina os envios.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contato exigido pelo padrão VAPID; os servidores de push usam para avisar
# sobre problemas de entrega. Vale um e-mail real.
VAPID_SUBJECT="mailto:tarcyo.alves@gmail.com"

# Segredo do Cron Job que varre escaladas de SOS (/api/cron/sos-escalada).
# A Vercel envia este valor em `Authorization: Bearer ...` nas chamadas
# agendadas em vercel.json.
#
# A rota RECUSA TUDO (503) enquanto esta variável não existir. É de propósito:
# um endpoint que dispara push em massa não pode ficar aberto porque alguém
# esqueceu a variável no deploy — falhar fechado é a escolha certa aqui.
#
# Gere um valor forte e único (não reaproveite outro segredo):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Ver docs/OPERACAO-SOS.md — inclusive o limite do plano Hobby, que só permite
# cron diário (quase inútil para emergência de minutos).
CRON_SECRET=""
