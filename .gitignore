# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.example não tem segredo, é documentação — precisa ir para o repo.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*
.tmp-media/

# Claude Code worktrees (agentes paralelos)
.claude/worktrees/

# Android build artifacts and caches (keep source files)
android/.gradle/
android/build/
android/app/build/
android/app/.gradle/
android/.idea/
android/local.properties
android/*.iml
# android/capacitor-cordova-android-plugins/ já é ignorado pelo android/.gitignore (auto-gerado pelo cap sync)

# Android signing secrets (never commit)
android/keystore.properties
android/app/google-services.json
*.jks
*.keystore

# Build logs
.android-icon-build.log

# Mobile shell: mantém index.html (fonte), ignora só artefatos que
# `npx cap sync` copiaria de outro build (bundles/assets gerados)
mobile-shell/assets/
mobile-shell/*.bundle.js
mobile-shell/*.bundle.css
